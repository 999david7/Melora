<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- WidgetKit only loads sandboxed extensions. -->
<key>com.apple.security.app-sandbox</key><true/>
<!-- The app writes now-playing state here; the widget may only read it. Must match WidgetShared.relativeDirectory. -->
<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
<array><string>/Library/Application Support/Melora/Widget/</string></array>
</dict></plist>
